# JJRAG configuration — copy to `.env` and fill in as needed.
# NOTE: In Accuracy mode you normally paste your key into the UI (kept in
# session memory only). These env vars are just an optional convenience.

# Where the local Ollama server listens (Privacy mode)
OLLAMA_HOST=http://localhost:11434

# Optional: only if you prefer env vars over the in-app key box
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: default endpoint for the OpenAI-compatible backend. Set this to the
# vLLM URL of a model you self-host — e.g. Kimi on an AMD Instinct GPU in AMD
# Developer Cloud. It pre-fills the "Endpoint base URL" box in the UI.
# See the README section "Running Kimi on AMD Developer Cloud".
# OPENAI_BASE_URL=http://<your-amd-droplet-ip>:8000/v1
