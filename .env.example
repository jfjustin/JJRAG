# JJRAG environment overrides.
#
# Everything in config/jjrag.yaml can be set here instead, using the JJRAG_
# prefix and __ for nested keys. Environment variables win over the YAML file.
#
# There are no model API keys in this file, because there is no hosted-model
# code path to use one. Generation and embeddings both run locally.

# ── Local model ───────────────────────────────────────────────────────────
JJRAG_LLM__HOST=http://localhost:11434
JJRAG_LLM__MODEL=llama3.1:8b

# ── Deployment ────────────────────────────────────────────────────────────
JJRAG_ENVIRONMENT=dev
JJRAG_SERVER__HOST=127.0.0.1
JJRAG_SERVER__PORT=8000

# ── Security ──────────────────────────────────────────────────────────────
# REQUIRED before exposing the app publicly. Generate: openssl rand -hex 32
# JJRAG_SECURITY__API_TOKEN=
# JJRAG_SECURITY__ALLOW_ANONYMOUS_READ=false
# Allowlist a self-hosted model server on your own network (JSON array):
# JJRAG_SECURITY__EXTRA_ALLOWED_HOSTS=["models.internal"]
