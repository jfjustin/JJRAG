# Copy to deploy/.env — this file is gitignored and must never be committed.

# Bearer token for the write endpoints (upload, ingest, delete, audit).
# Generate one with: openssl rand -hex 32
JJRAG_API_TOKEN=

# Local generation model. Pull it after the stack is up:
#   docker compose -f deploy/docker-compose.yml exec ollama ollama pull llama3.1:8b
# Smaller hosts: llama3.2:3b or phi3:mini. Larger: qwen2.5:14b, llama3.1:70b.
JJRAG_MODEL=llama3.1:8b

# Only needed for the `tunnel` profile. Created in the Cloudflare Zero Trust
# dashboard: Networks → Tunnels → Create a tunnel → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=
